{
  "name": "opencode-memory-pro",
  "version": "1.3.1",
  "description": "LanceDB-backed long-term memory provider for OpenCode — standalone fork of lancedb-opencode-pro with entity graph, lifecycle, and retention",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "lancedb",
    "entity-graph",
    "retention"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/unit.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "test:e2e": "node test/scenario-e2e.mjs",
    "verify": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.38.0",
    "@opencode-ai/plugin": "^1.4.10",
    "@opencode-ai/sdk": "^1.4.10"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
